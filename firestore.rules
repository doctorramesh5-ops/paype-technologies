rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['admin@paype.co.in'];
    }

    // Users - owner can read/write their own data; admin has full access
    match /paype_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Payments - any signed-in user (incl. phone-OTP custom flow) can create their own payment record;
    // only admin can read the full list or edit/delete
    match /paype_payments/{paymentId} {
      allow create: if true; // Razorpay success callback runs before/without full auth in phone-OTP flow
      allow read, update, delete: if isAdmin();
    }

    // Support tickets - anyone can create (contact form), only admin can read/manage
    match /paype_tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings - admin only
    match /paype_settings/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
